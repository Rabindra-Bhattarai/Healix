PORT=5000
MONGO_URI=mongodb://localhost:27018/healix
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,https://localhost:3000

# Google Sign-In: Google Cloud Console > APIs & Services > Credentials > OAuth client ID
GOOGLE_CLIENT_ID=

# Facebook Login: developers.facebook.com > Your App > Settings > Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Resend (registration OTP emails): resend.com > API Keys
# Leave unset during local dev and the OTP will just be printed to this
# server's console instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=Healix <onboarding@resend.dev>

# AI Symptom Triage: Google AI Studio (aistudio.google.com/apikey) - free tier
GEMINI_API_KEY=
